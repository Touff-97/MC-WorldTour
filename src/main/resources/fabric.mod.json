{
	"schemaVersion": 1,
	"id": "worldtourmod",
	"version": "${version}",
	"name": "World Tour Mod",
	"description": "This mod is made to specifically stage an automated world tour for Etho's massive world, but could apply to others",
	"authors": [
		"Touff-97"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/Touff-97/MC-WorldTour"
	},
	"license": "MIT-License",
	"icon": "assets/worldtourmod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.byhobby.worldtourmod.WorldTourMod"
		],
		"fabric-datagen": [
			"net.byhobby.worldtourmod.WorldTourModDataGenerator"
		]
	},
	"mixins": [
		"worldtourmod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
